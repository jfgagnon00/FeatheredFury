ARG PYTHON_VERSION=3.9-slim

FROM python:${PYTHON_VERSION}

ARG PORT
ARG AZURE_STORAGE_CONNECTION_STRING

WORKDIR /app

# libsndfile1 pour librosa
RUN apt-get update && \
    apt-get install -y libsndfile1 && \
    rm -rf /var/lib/apt/lists/*

# installation fichiers necessaire a ffury
COPY setup.py .
COPY ffury.yaml .
COPY .ci/ .ci/
COPY configs/ configs/
COPY src/ffury/ src/ffury/
COPY data/data__species.csv data/data__species.csv
COPY models/Model.keras models/Model.keras

# installation ffury
RUN pip install --no-cache-dir --use-pep517 -e .\[service\] && \
    rm -rf .ci/ && \
    rm setup.py

EXPOSE ${PORT}

ENV AZURE_STORAGE_CONNECTION_STRING=${AZURE_STORAGE_CONNECTION_STRING}

CMD ["ffury", "service"]
