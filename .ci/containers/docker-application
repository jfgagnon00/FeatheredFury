ARG PYTHON_VERSION=3.9-slim

FROM python:${PYTHON_VERSION}

ARG PORT

WORKDIR /app

# installation fichiers necessaire a ffury
COPY setup.py .
COPY ffury.yaml .
COPY .ci/ .ci/
COPY configs/ configs/
COPY src/ffury/ src/ffury/
COPY data/data__species.csv data/data__species.csv

# installation ffury
RUN pip install --no-cache-dir --use-pep517 -e .\[application\] && \
    rm -rf .ci/ && \
    rm setup.py

EXPOSE ${PORT}

CMD ["ffury", "application"]
