ARG PLATFORM=linux/amd64
ARG PYTHON_VERSION=3.9-slim
ARG APPLICATION_PORT=5000
ARG SERVICE_PORT=5001

FROM --platform=${PLATFORM} python:${PYTHON_VERSION}

ENV FFURY_APPLICATION_PORT=${APPLICATION_PORT}
ENV FFURY_SERVICE_PORT=${SERVICE_PORT}

WORKDIR /app

COPY setup.py .
COPY ffury.yaml .
COPY .ci/ .ci/
COPY configs/ configs/
COPY src/ffury/ src/ffury/

RUN pip install --no-cache-dir --use-pep517 -e .\[application\] && \
    rm -rf .ci/ && \
    rm setup.py

EXPOSE ${APPLICATION_PORT}

CMD ["ffury", "application"]
